{
  "name": "@kairos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo api:no-lint"
  },
  "dependencies": {
    "@kairos/config": "workspace:*",
    "@kairos/db": "workspace:*",
    "@kairos/email": "workspace:*",
    "@kairos/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.1.0",
    "openai": "^6.35.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "mysql2": "^3.15.0",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}

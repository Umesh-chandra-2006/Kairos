# ===================================================================
# Kairos - Environment Variables
# Copy to .env for local development. NEVER commit .env.
# ===================================================================

# --- Database (MySQL 8) ---
# Host port 3307 matches docker-compose.yml (remapped from 3306 to avoid conflicts)
DATABASE_URL=mysql://kairos:kairos@localhost:3307/kairos

# --- Redis (optional at runtime; used for queue + SSE fan-out) ---
# Host port 6380 matches docker-compose.yml (remapped from 6379 to avoid conflicts)
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-48-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI Evaluation (OpenRouter) ---
# Get from: https://openrouter.ai/keys  (format: sk-or-...)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT_MS=30000
# How long model-answer evaluations are cached in Redis (seconds)
OPENROUTER_CACHE_TTL_SEC=86400

# --- Email (Resend) ---
# Optional: without it, emails are logged in development
RESEND_API_KEY=
EMAIL_FROM="Kairos <onboarding@resend.dev>"
APP_URL=http://localhost:5173

# --- App ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Mobile (Expo) ---
# API base URL the mobile app talks to. On a device/simulator use your
# machine's LAN IP (e.g. http://192.168.1.10:4000). Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# --- Web Push (VAPID) ---
# Generate with: node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(JSON.stringify(k))"
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@kairos.dev
